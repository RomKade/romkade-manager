
# ROMKADE Cloud (MCP pour ChatGPT/Claude + relais des consoles) - conteneur romkade-cloud.
mcp.romkade.com {
  encode zstd gzip
  request_body {
    max_size 16MB
  }
  # Par APISIX (limites de débit, routes romkade-mcp et romkade-agent ; ~/app/gateway/README.md sur la droplet),
  # qui transmet à romkade-cloud:8787.
  reverse_proxy apisix:9080 {
    flush_interval -1
  }
}
